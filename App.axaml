<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SortingVisualizer.App"
             xmlns:local="using:SortingVisualizer"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://SortingVisualizer/Views/Styles/ControlStyle.axaml"/>
        <StyleInclude Source="avares://SortingVisualizer/Views/Styles/HeaderStyle.axaml"/>
        <StyleInclude Source="avares://SortingVisualizer/Views/Styles/StatsStyle.axaml"/>
        <StyleInclude Source="avares://SortingVisualizer/Views/Styles/ArrayVisualizerStyle.axaml"/>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://SortingVisualizer/Assets/Fonts/#Roboto Slab"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="avares://SortingVisualizer/Assets/Fonts/#Roboto Slab"/>
        </Style>
    </Application.Styles>
</Application>